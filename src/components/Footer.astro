---
import { NAV, BRAND, BUSINESS, META, FOOTER, CONTACT } from '../data/copy.ts';
import { langOf, legalPath, t } from '../data/i18n.ts';

const lang = langOf(Astro.currentLocale);
---

<footer class="footer">
  <div class="footer__nav">
    <div class="footer__col">
      <span class="footer__heading">{t(FOOTER.studioCol.heading, lang)}</span>
      {
        FOOTER.studioCol.links.map((l) => (
          <a href={l.href} class="footer__link">{t(l.label, lang)}</a>
        ))
      }
    </div>

    <div class="footer__col">
      <span class="footer__heading">{t(FOOTER.legalCol.heading, lang)}</span>
      {
        FOOTER.legalCol.links.map((l) => (
          <a href={legalPath(l.slug, lang)} class="footer__link">{t(l.label, lang)}</a>
        ))
      }
    </div>

    <div class="footer__col">
      <span class="footer__heading">{t(FOOTER.areaCol.heading, lang)}</span>
      {
        FOOTER.areaCol.links.map((l) => (
          <a href={l.href} class="footer__link">{t(l.label, lang)}</a>
        ))
      }
    </div>

    <div class="footer__col">
      <span class="footer__heading">{t(FOOTER.contactCol.heading, lang)}</span>
      <a href={`mailto:${CONTACT.email}`} class="footer__link">{CONTACT.email}</a>
      {/* Teléfono clicable: desde el móvil se llama de un toque, y es el mismo
          número que el del perfil de empresa de Google. */}
      <a href={`tel:${BUSINESS.telephone}`} class="footer__link">
        {BUSINESS.telephoneDisplay}
      </a>
      <span class="footer__note">{t(FOOTER.contactCol.note, lang)}</span>
    </div>
  </div>

  <div class="footer__brand-row">
    <a href="#top" class="footer__brand" aria-label={`${BRAND} — ${t(NAV.home, lang)}`}>
      <img src="/logo-wordmark-compact.png" alt={BRAND} width="1180" height="240" class="footer__logo" />
    </a>
    <span class="footer__tagline">{t(META.tagline, lang)}</span>
  </div>

  <div class="footer__bottom">
    <span>{t(FOOTER.copyright, lang)}</span>
    <span>{t(FOOTER.location, lang)}</span>
  </div>
</footer>

<style>
  .footer {
    padding: var(--gutter);
  }

  .footer__nav {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 30px;
    padding-bottom: 40px;
    border-bottom: var(--line-primary);
  }

  .footer__col {
    display: flex;
    flex-direction: column;
    gap: 14px;
    font-family: var(--font-mono);
    font-size: 14px;
  }

  .footer__heading {
    color: var(--grey-muted);
    letter-spacing: 0.06em;
  }

  .footer__note {
    color: var(--grey-muted);
    font-size: 12px;
  }

  .footer__link {
    text-decoration: none;
    color: var(--ink);
    transition: color 0.15s, padding-left 0.15s;
  }

  .footer__link:hover,
  .footer__link:focus-visible {
    color: var(--blue);
    padding-left: 4px;
  }

  .footer__brand-row {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 18px;
    padding: 28px 0;
    border-bottom: 1px solid var(--hairline);
  }

  .footer__brand {
    display: flex;
    align-items: center;
    gap: 12px;
    text-decoration: none;
    color: var(--ink);
  }

  .footer__logo {
    width: auto;
    height: 32px;
  }

  .footer__tagline {
    font-family: var(--font-mono);
    font-size: 12px;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--grey-muted);
  }

  .footer__bottom {
    display: flex;
    justify-content: space-between;
    align-items: center;
    flex-wrap: wrap;
    gap: 16px;
    padding-top: 24px;
    font-family: var(--font-mono);
    font-size: 12px;
    color: var(--grey-muted);
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }

  /* --- responsive --- */
  @media (max-width: 900px) {
    .footer__nav {
      grid-template-columns: repeat(2, 1fr);
      gap: 28px;
    }
  }

  @media (max-width: 600px) {
    .footer {
      padding: 32px 20px;
    }
    .footer__nav {
      grid-template-columns: 1fr;
      gap: 28px;
    }
  }
</style>
