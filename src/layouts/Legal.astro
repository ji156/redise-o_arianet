---
import Base from './Base.astro';
import { NAV, BRAND, FOOTER } from '../data/copy.ts';
import { LEGAL, legalDocs, type LegalDoc } from '../data/legal.ts';
import {
  DEFAULT_LANG,
  LANG_NAME,
  LANG_SHORT,
  homePath,
  langOf,
  legalAlternates,
  legalPath,
  otherLangs,
  t,
} from '../data/i18n.ts';

interface Props {
  doc: LegalDoc;
}

const { doc } = Astro.props;
const lang = langOf(Astro.currentLocale);

const alternates = legalAlternates(doc.slug);
const langLinks = otherLangs(lang, alternates);
const title = `${t(doc.title, lang)} — ${BRAND}`;
---

<Base title={title} description={t(doc.intro, lang)} alternates={alternates}>
  <header class="lhead">
    <a href={homePath(lang)} class="lhead__brand" aria-label={`${BRAND} — ${t(NAV.home, lang)}`}>
      <img src="/logo-wordmark-compact.png" alt={BRAND} width="1180" height="240" class="lhead__logo" />
    </a>
    <div class="lhead__actions">
      {
        langLinks.map((l) => (
          <a
            href={l.href}
            class="lhead__lang"
            hreflang={l.code}
            lang={l.code}
            aria-label={LANG_NAME[l.code]}
          >
            {LANG_SHORT[l.code]}
          </a>
        ))
      }
      <a href={homePath(lang)} class="lhead__back">{t(LEGAL.back, lang)}</a>
    </div>
  </header>

  <main class="legal">
    <aside class="legal__nav" aria-label={t(LEGAL.index, lang)}>
      <span class="legal__nav-title">{t(LEGAL.index, lang)}</span>
      {
        legalDocs.map((d) => (
          <a
            href={legalPath(d.slug, lang)}
            class="legal__nav-link"
            aria-current={d.slug === doc.slug ? 'page' : undefined}>{t(d.nav, lang)}</a>
        ))
      }
    </aside>

    <article class="legal__doc">
      <h1 class="legal__title">{t(doc.title, lang)}</h1>
      <p class="legal__intro">{t(doc.intro, lang)}</p>
      {
        /* Fuera del castellano, avisa de que el original es el que vincula.
           Va antes de `legal__updated`, que es quien cierra el bloque con su
           línea inferior. */
        lang !== DEFAULT_LANG && (
          <p class="legal__translation-note">{t(LEGAL.translationNote, lang)}</p>
        )
      }
      <p class="legal__updated">{t(LEGAL.updated, lang)}</p>

      {
        doc.sections.map((s) => (
          <section class="legal__section">
            <h2 class="legal__h2">{t(s.heading, lang)}</h2>
            {s.paragraphs.map((p) => (
              <p class="legal__p">{t(p, lang)}</p>
            ))}
          </section>
        ))
      }
    </article>
  </main>

  <footer class="lfoot">
    <div class="lfoot__links">
      {
        legalDocs.map((d) => (
          <a href={legalPath(d.slug, lang)} class="lfoot__link">{t(d.nav, lang)}</a>
        ))
      }
    </div>
    <span class="lfoot__copy">{t(FOOTER.copyright, lang)}</span>
  </footer>
</Base>

<style>
  .lhead {
    position: sticky;
    top: 0;
    z-index: 100;
    display: flex;
    align-items: stretch;
    justify-content: space-between;
    background: var(--paper);
    border-bottom: var(--line-primary);
  }

  .lhead__brand {
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 16px 26px;
    text-decoration: none;
    color: var(--ink);
    border-right: var(--line-primary);
  }

  .lhead__logo {
    width: auto;
    height: 22px;
  }

  .lhead__actions {
    display: flex;
    align-items: center;
    gap: 16px;
    padding-right: 26px;
  }

  .lhead__lang {
    font-family: var(--font-mono);
    font-size: 13px;
    font-weight: 700;
    background: var(--paper);
    border: var(--line-primary);
    color: var(--ink);
    padding: 6px 11px;
    text-decoration: none;
    letter-spacing: 0.04em;
    transition: background 0.15s, color 0.15s;
  }

  .lhead__lang:hover,
  .lhead__lang:focus-visible {
    background: var(--ink);
    color: #fff;
  }

  .lhead__back {
    font-family: var(--font-mono);
    font-size: 13px;
    color: var(--ink);
    text-decoration: none;
    transition: color 0.15s;
  }

  .lhead__back:hover,
  .lhead__back:focus-visible {
    color: var(--blue);
  }

  /* --- cuerpo --- */
  .legal {
    display: grid;
    grid-template-columns: 260px 1fr;
    max-width: 1180px;
    margin: 0 auto;
    border-left: var(--line-primary);
    border-right: var(--line-primary);
    min-height: calc(100vh - 62px);
  }

  .legal__nav {
    display: flex;
    flex-direction: column;
    gap: 4px;
    padding: 48px 26px;
    border-right: var(--line-primary);
    position: sticky;
    top: 62px;
    align-self: start;
  }

  .legal__nav-title {
    font-family: var(--font-mono);
    font-size: 11px;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--grey-muted);
    margin-bottom: 14px;
  }

  .legal__nav-link {
    font-family: var(--font-mono);
    font-size: 14px;
    color: var(--ink);
    text-decoration: none;
    padding: 8px 0;
    border-bottom: 1px solid var(--hairline-soft);
    transition: color 0.15s, padding-left 0.15s;
  }

  .legal__nav-link:hover,
  .legal__nav-link:focus-visible {
    color: var(--blue);
    padding-left: 6px;
  }

  .legal__nav-link[aria-current='page'] {
    color: var(--blue);
    font-weight: 700;
  }

  .legal__doc {
    padding: 48px 54px 72px;
    max-width: 760px;
  }

  .legal__title {
    font-family: var(--font-display);
    font-weight: 900;
    font-size: clamp(34px, 5vw, 56px);
    line-height: 0.95;
    letter-spacing: -0.03em;
    text-transform: uppercase;
  }

  .legal__intro {
    font-family: var(--font-body);
    font-size: 17px;
    line-height: 1.55;
    color: var(--grey-body);
    margin-top: 20px;
  }

  .legal__translation-note {
    font-family: var(--font-mono);
    font-size: 12px;
    letter-spacing: 0.04em;
    color: var(--ink);
    margin-top: 18px;
    padding: 10px 14px;
    border-left: 3px solid var(--blue);
    background: var(--grey-soft, transparent);
  }

  .legal__updated {
    font-family: var(--font-mono);
    font-size: 12px;
    letter-spacing: 0.04em;
    color: var(--grey-muted);
    margin-top: 18px;
    padding-bottom: 28px;
    border-bottom: var(--line-primary);
  }

  .legal__section {
    margin-top: 34px;
  }

  .legal__h2 {
    font-family: var(--font-display);
    font-weight: 800;
    font-size: 21px;
    letter-spacing: -0.01em;
    text-transform: uppercase;
    margin-bottom: 14px;
  }

  .legal__p {
    font-family: var(--font-body);
    font-size: 16px;
    line-height: 1.65;
    color: var(--grey-body);
    margin-bottom: 12px;
  }

  /* --- pie --- */
  .lfoot {
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 16px;
    padding: 24px var(--gutter);
    border-top: var(--line-primary);
  }

  .lfoot__links {
    display: flex;
    flex-wrap: wrap;
    gap: 20px;
    font-family: var(--font-mono);
    font-size: 13px;
  }

  .lfoot__link {
    color: var(--ink);
    text-decoration: none;
    transition: color 0.15s;
  }

  .lfoot__link:hover,
  .lfoot__link:focus-visible {
    color: var(--blue);
  }

  .lfoot__copy {
    font-family: var(--font-mono);
    font-size: 12px;
    color: var(--grey-muted);
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }

  /* --- responsive --- */
  @media (max-width: 860px) {
    .legal {
      grid-template-columns: 1fr;
      border-left: none;
      border-right: none;
    }
    .legal__nav {
      position: static;
      flex-direction: row;
      flex-wrap: wrap;
      gap: 10px 18px;
      padding: 20px var(--gutter);
      border-right: none;
      border-bottom: var(--line-primary);
    }
    .legal__nav-title {
      flex-basis: 100%;
      margin-bottom: 4px;
    }
    .legal__nav-link {
      border-bottom: none;
      padding: 0;
    }
    .legal__nav-link:hover,
    .legal__nav-link:focus-visible {
      padding-left: 0;
    }
    .legal__doc {
      padding: 36px var(--gutter) 56px;
    }
  }

  @media (max-width: 600px) {
    .lhead__brand {
      padding: 14px 18px;
    }
    .lhead__actions {
      gap: 12px;
      padding-right: 18px;
    }
    .lhead__back {
      display: none; /* el logo ya vuelve al inicio */
    }
    .legal__nav,
    .legal__doc,
    .lfoot {
      padding-left: 20px;
      padding-right: 20px;
    }
  }
</style>
