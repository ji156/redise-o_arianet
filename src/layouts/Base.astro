---
// Fuentes auto-hospedadas (servidas desde el propio dominio, sin terceros).
// Sólo los pesos usados y el subset `latin` (cubre español e inglés: ñ, tildes,
// ¿, ¡), para empaquetar lo mínimo imprescindible.
import '@fontsource/archivo/latin-500.css';
import '@fontsource/archivo/latin-600.css';
import '@fontsource/archivo/latin-700.css';
import '@fontsource/archivo/latin-800.css';
import '@fontsource/archivo/latin-900.css';
import '@fontsource/space-grotesk/latin-400.css';
import '@fontsource/space-grotesk/latin-500.css';
import '@fontsource/space-grotesk/latin-600.css';
import '@fontsource/space-grotesk/latin-700.css';
import '@fontsource/space-mono/latin-400.css';
import '@fontsource/space-mono/latin-700.css';

import '../styles/global.css';
import { BRAND, SEO_DEFAULT } from '../data/copy.ts';
import { DEFAULT_LANG, OG_LOCALE, t } from '../data/i18n.ts';
import type { Alternates, Lang } from '../data/i18n.ts';
import { businessSchema, webSiteSchema } from '../data/schema.ts';
import CookieBanner from '../components/CookieBanner.astro';

interface Props {
  title?: string;
  description?: string;
  /** Bloques JSON-LD de la página. El de negocio + sitio se añaden siempre. */
  schema?: Record<string, unknown>[];
  /** Excluye la página del índice (404, gracias, etc.). */
  noindex?: boolean;
  /** Idioma de la página. Por defecto, el que deduce Astro de la ruta. */
  lang?: Lang;
  /**
   * Rutas equivalentes de esta página en cada idioma, de donde salen los
   * `hreflang`. Vacío = la página existe sólo en su idioma (landings locales),
   * y entonces no se declara ninguna alternativa.
   */
  alternates?: Alternates;
}

const { title, description, schema = [], noindex = false, alternates = {} } = Astro.props;

// `Astro.currentLocale` sale del prefijo de la ruta (/en/…), con el castellano
// como valor para la raíz. La prop `lang` sólo hace falta donde no hay prefijo
// que leer.
const lang: Lang = Astro.props.lang ?? ((Astro.currentLocale as Lang) || DEFAULT_LANG);

const pageTitle = title ?? t(SEO_DEFAULT.title, lang);
const pageDescription = description ?? t(SEO_DEFAULT.description, lang);

// URLs absolutas para canonical y Open Graph (requeridas por redes sociales).
// `Astro.site` viene de astro.config.mjs (https://arianet.eu).
const canonical = new URL(Astro.url.pathname, Astro.site).href;
const ogImage = new URL('/og-image.png', Astro.site).href;

const abs = (path: string) => new URL(path, Astro.site).href;

// Los hreflang sólo tienen sentido en grupo: una única alternativa apuntándose
// a sí misma no aporta nada, así que por debajo de dos idiomas no se emiten.
const altEntries = Object.entries(alternates) as [Lang, string][];
const hasAlternates = altEntries.length > 1;

// El negocio y el sitio se declaran en TODAS las páginas: cada una refuerza la
// misma entidad local en lugar de dejarla sólo en la home.
const jsonLd = [businessSchema(lang), webSiteSchema(lang), ...schema];
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />

    <title>{pageTitle}</title>
    <meta name="description" content={pageDescription} />
    <meta name="theme-color" content="#0A0A0A" />
    <link rel="canonical" href={canonical} />
    {
      /* Versiones por idioma. Cada página debe listarse a sí misma además de a
         sus alternativas, o Google descarta el grupo entero. `x-default` marca
         a dónde mandar al resto del mundo: el castellano, que es la versión
         completa. */
      hasAlternates && (
        <>
          {altEntries.map(([code, path]) => (
            <link rel="alternate" hreflang={code} href={abs(path)} />
          ))}
          <link rel="alternate" hreflang="x-default" href={abs(alternates.es ?? '/')} />
        </>
      )
    }
    {
      /* max-snippet/max-image-preview: sin esto Google recorta el fragmento y
         usa miniatura pequeña; con esto puede mostrar descripción larga e
         imagen grande, que ocupa más espacio en los resultados. */
    }
    <meta
      name="robots"
      content={noindex
        ? 'noindex, follow'
        : 'index, follow, max-snippet:-1, max-image-preview:large, max-video-preview:-1'}
    />
    <meta name="author" content={BRAND} />
    {/* Cobertura geográfica: la leen Bing y varios agregadores locales. */}
    <meta name="geo.region" content="ES-SS" />
    <meta name="geo.placename" content="Irún, Gipuzkoa" />
    <meta name="geo.position" content="43.3376;-1.7889" />
    <meta name="ICBM" content="43.3376, -1.7889" />

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={BRAND} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={pageDescription} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={t(SEO_DEFAULT.imageAlt, lang)} />
    <meta property="og:locale" content={OG_LOCALE[lang]} />
    {
      altEntries
        .filter(([code]) => code !== lang)
        .map(([code]) => <meta property="og:locale:alternate" content={OG_LOCALE[code]} />)
    }

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={pageDescription} />
    <meta name="twitter:image" content={ogImage} />

    {/* 96x96 primero: Google exige un favicon múltiplo de 48px para mostrarlo en resultados */}
    <link rel="icon" type="image/png" sizes="96x96" href="/favicon-96.png" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png" />
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16.png" />
    <link rel="shortcut icon" href="/favicon.ico" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />

    {
      /* Datos estructurados. `set:html` con JSON.stringify evita que Astro
         escape las comillas del JSON (romperían el parseo del bot). */
      jsonLd.map((block) => (
        <script type="application/ld+json" is:inline set:html={JSON.stringify(block)} />
      ))
    }

    {
      /* Umami (analítica sin cookies, instancia propia). Solo en producción
         y limitado al dominio real para no ensuciar datos desde previews. */
      import.meta.env.PROD && (
        <script
          is:inline
          defer
          src="https://stats.arianet.eu/script.js"
          data-website-id="82922f02-669c-4189-80c4-9c4da7829af7"
          data-domains="arianet.eu,www.arianet.eu"
        />
      )
    }
  </head>
  <body>
    <slot />

    <CookieBanner />

    <script>
      import { initReveal } from '../scripts/reveal.ts';
      import { initMenu } from '../scripts/menu.ts';
      import { initCookies } from '../scripts/cookies.ts';

      const boot = () => {
        initReveal();
        initMenu();
        initCookies();
      };

      if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', boot);
      } else {
        boot();
      }
    </script>
  </body>
</html>
