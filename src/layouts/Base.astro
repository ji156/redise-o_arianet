---
// Fuentes auto-hospedadas (servidas desde el propio dominio, sin terceros).
// Sólo los pesos usados y el subset `latin` (cubre español e inglés: ñ, tildes,
// ¿, ¡), para empaquetar lo mínimo imprescindible.
import '@fontsource/archivo/latin-500.css';
import '@fontsource/archivo/latin-600.css';
import '@fontsource/archivo/latin-700.css';
import '@fontsource/archivo/latin-800.css';
import '@fontsource/archivo/latin-900.css';
import '@fontsource/space-grotesk/latin-400.css';
import '@fontsource/space-grotesk/latin-500.css';
import '@fontsource/space-grotesk/latin-600.css';
import '@fontsource/space-grotesk/latin-700.css';
import '@fontsource/space-mono/latin-400.css';
import '@fontsource/space-mono/latin-700.css';

import '../styles/global.css';
import { BRAND } from '../data/copy.ts';
import { businessSchema, webSiteSchema } from '../data/schema.ts';
import CookieBanner from '../components/CookieBanner.astro';

interface Props {
  title?: string;
  description?: string;
  /** Bloques JSON-LD de la página. El de negocio + sitio se añaden siempre. */
  schema?: Record<string, unknown>[];
  /** Excluye la página del índice (404, gracias, etc.). */
  noindex?: boolean;
}

const {
  // Título y descripción por defecto = los de la home. Llevan la ciudad delante
  // a propósito: es la primera línea que lee Google y la que ve el usuario en
  // los resultados, y sin ella no competimos por ninguna búsqueda local.
  title = 'Diseño de páginas web en Irún y Gipuzkoa | arianet',
  description = 'Diseño y programación de páginas web en Irún. Webs a medida, tiendas online y SEO local para negocios de Irún, San Sebastián y Gipuzkoa. Desde 29 €/mes.',
  schema = [],
  noindex = false,
} = Astro.props;

// URLs absolutas para canonical y Open Graph (requeridas por redes sociales).
// `Astro.site` viene de astro.config.mjs (https://arianet.eu).
const canonical = new URL(Astro.url.pathname, Astro.site).href;
const ogImage = new URL('/og-image.png', Astro.site).href;

// El negocio y el sitio se declaran en TODAS las páginas: cada una refuerza la
// misma entidad local en lugar de dejarla sólo en la home.
const jsonLd = [businessSchema(), webSiteSchema(), ...schema];
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />

    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#0A0A0A" />
    <link rel="canonical" href={canonical} />
    {
      /* max-snippet/max-image-preview: sin esto Google recorta el fragmento y
         usa miniatura pequeña; con esto puede mostrar descripción larga e
         imagen grande, que ocupa más espacio en los resultados. */
    }
    <meta
      name="robots"
      content={noindex
        ? 'noindex, follow'
        : 'index, follow, max-snippet:-1, max-image-preview:large, max-video-preview:-1'}
    />
    <meta name="author" content={BRAND} />
    {/* Cobertura geográfica: la leen Bing y varios agregadores locales. */}
    <meta name="geo.region" content="ES-SS" />
    <meta name="geo.placename" content="Irún, Gipuzkoa" />
    <meta name="geo.position" content="43.3376;-1.7889" />
    <meta name="ICBM" content="43.3376, -1.7889" />

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={BRAND} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={`${BRAND} — estudio digital`} />
    <meta property="og:locale" content="es_ES" />
    <meta property="og:locale:alternate" content="en_US" />

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    {/* 96x96 primero: Google exige un favicon múltiplo de 48px para mostrarlo en resultados */}
    <link rel="icon" type="image/png" sizes="96x96" href="/favicon-96.png" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png" />
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16.png" />
    <link rel="shortcut icon" href="/favicon.ico" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />

    {
      /* Datos estructurados. `set:html` con JSON.stringify evita que Astro
         escape las comillas del JSON (romperían el parseo del bot). */
      jsonLd.map((block) => (
        <script type="application/ld+json" is:inline set:html={JSON.stringify(block)} />
      ))
    }

    {
      /* Umami (analítica sin cookies, instancia propia). Solo en producción
         y limitado al dominio real para no ensuciar datos desde previews. */
      import.meta.env.PROD && (
        <script
          is:inline
          defer
          src="https://stats.arianet.eu/script.js"
          data-website-id="82922f02-669c-4189-80c4-9c4da7829af7"
          data-domains="arianet.eu,www.arianet.eu"
        />
      )
    }
  </head>
  <body>
    <slot />

    <CookieBanner />

    <script>
      import { initReveal } from '../scripts/reveal.ts';
      import { initLangToggle } from '../scripts/lang.ts';
      import { initMenu } from '../scripts/menu.ts';
      import { initCookies } from '../scripts/cookies.ts';

      const boot = () => {
        initReveal();
        initLangToggle();
        initMenu();
        initCookies();
      };

      if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', boot);
      } else {
        boot();
      }
    </script>
  </body>
</html>
