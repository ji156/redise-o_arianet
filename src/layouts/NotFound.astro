---
import Base from './Base.astro';
import { NAV, BRAND, FOOTER, NOT_FOUND } from '../data/copy.ts';
import { legalDocs } from '../data/legal.ts';
import {
  LANG_NAME,
  LANG_SHORT,
  homePath,
  langOf,
  legalPath,
  otherLangs,
  t,
} from '../data/i18n.ts';

/**
 * Página de error 404, una por idioma. El idioma sale del prefijo de la ruta,
 * como en el resto del sitio, pero aquí quien elige el fichero es nginx: el
 * vhost del host declara un `error_page` por prefijo.
 *
 *   /404.html               ← respaldo, y lo que se sirve sin idioma en la ruta
 *   /eu/404/index.html      ← error_page del location /eu/
 *   /en/404/index.html      ← error_page del location /en/
 *
 * Las de idioma acaban en `404/index.html` y no en `404.html` porque el build
 * es en modo `directory`: sólo la raíz recibe el trato especial de Astro. Al
 * `error_page` le da igual, pero hay que apuntarlo a la ruta exacta.
 *
 * Si el vhost no lleva esos `error_page`, todo cae en la castellana: nada se
 * rompe, sólo se ve en castellano.
 */
const lang = langOf(Astro.currentLocale);
const langLinks = otherLangs(lang);
const title = `${t(NOT_FOUND.title, lang)} — ${BRAND}`;
---

{/* noindex: una 404 indexada sólo gasta presupuesto de rastreo. */}
<Base title={title} description={t(NOT_FOUND.message, lang)} noindex>
  <header class="nf-head">
    <a href={homePath(lang)} class="nf-head__brand" aria-label={`${BRAND} — ${t(NAV.home, lang)}`}>
      <img src="/logo-wordmark-compact.png" alt={BRAND} width="1180" height="240" class="nf-head__logo" />
    </a>
    {
      langLinks.map((l) => (
        <a
          href={l.href}
          class="nf-head__lang"
          hreflang={l.code}
          lang={l.code}
          aria-label={LANG_NAME[l.code]}
        >
          {LANG_SHORT[l.code]}
        </a>
      ))
    }
  </header>

  <main class="nf">
    <span class="nf__eyebrow">{t(NOT_FOUND.eyebrow, lang)}</span>
    <p class="nf__code" aria-hidden="true">404</p>
    <h1 class="nf__title">{t(NOT_FOUND.title, lang)}</h1>
    <p class="nf__message">{t(NOT_FOUND.message, lang)}</p>
    <a href={homePath(lang)} class="btn btn--blue">{t(NOT_FOUND.cta, lang)}</a>
  </main>

  <footer class="nf-foot">
    <div class="nf-foot__links">
      {
        legalDocs.map((d) => (
          <a href={legalPath(d.slug, lang)} class="nf-foot__link">{t(d.nav, lang)}</a>
        ))
      }
    </div>
    <span class="nf-foot__copy">{t(FOOTER.copyright, lang)}</span>
  </footer>
</Base>

<style>
  .nf-head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 16px 26px;
    border-bottom: var(--line-primary);
  }

  .nf-head__brand {
    display: flex;
    align-items: center;
    gap: 10px;
    text-decoration: none;
    color: var(--ink);
  }

  .nf-head__logo {
    width: auto;
    height: 22px;
  }

  .nf-head__lang {
    font-family: var(--font-mono);
    font-size: 13px;
    font-weight: 700;
    background: var(--paper);
    border: var(--line-primary);
    color: var(--ink);
    padding: 6px 11px;
    text-decoration: none;
    letter-spacing: 0.04em;
    transition: background 0.15s, color 0.15s;
  }

  .nf-head__lang:hover,
  .nf-head__lang:focus-visible {
    background: var(--ink);
    color: #fff;
  }

  .nf {
    min-height: calc(100dvh - 62px - 60px);
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    text-align: center;
    padding: 48px var(--gutter);
  }

  .nf__eyebrow {
    font-family: var(--font-mono);
    font-size: 13px;
    letter-spacing: 0.08em;
    color: var(--grey-muted);
    margin-bottom: 18px;
  }

  .nf__code {
    font-family: var(--font-display);
    font-weight: 900;
    font-size: clamp(96px, 18vw, 220px);
    line-height: 0.85;
    letter-spacing: -0.04em;
    color: transparent;
    -webkit-text-stroke: 2px var(--ink);
    margin: 0;
  }

  @supports not (-webkit-text-stroke: 2px #000) {
    .nf__code {
      color: var(--ink);
    }
  }

  .nf__title {
    font-family: var(--font-display);
    font-weight: 800;
    font-size: clamp(24px, 3vw, 34px);
    text-transform: uppercase;
    letter-spacing: -0.01em;
    margin-top: 20px;
  }

  .nf__message {
    font-family: var(--font-body);
    font-size: 17px;
    color: var(--grey-body);
    max-width: 480px;
    margin-top: 14px;
  }

  .nf .btn {
    margin-top: 34px;
    text-decoration: none;
    background: var(--blue);
    color: #fff;
    border: var(--line-primary);
  }

  .nf .btn:hover,
  .nf .btn:focus-visible {
    background: var(--ink);
  }

  .nf-foot {
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 16px;
    padding: 24px var(--gutter);
    border-top: var(--line-primary);
  }

  .nf-foot__links {
    display: flex;
    flex-wrap: wrap;
    gap: 20px;
    font-family: var(--font-mono);
    font-size: 13px;
  }

  .nf-foot__link {
    color: var(--ink);
    text-decoration: none;
    transition: color 0.15s;
  }

  .nf-foot__link:hover,
  .nf-foot__link:focus-visible {
    color: var(--blue);
  }

  .nf-foot__copy {
    font-family: var(--font-mono);
    font-size: 12px;
    color: var(--grey-muted);
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }

  @media (max-width: 600px) {
    .nf-head {
      padding: 14px 18px;
    }
    .nf {
      padding: 40px 20px;
    }
    .nf-foot {
      padding: 20px 20px;
    }
  }
</style>
