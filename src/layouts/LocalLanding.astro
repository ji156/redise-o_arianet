---
/**
 * Landing local (/diseno-web-irun, /diseno-web-san-sebastian,
 * /paginas-web-gipuzkoa).
 *
 * Página completa con contenido propio por zona, no una plantilla con la ciudad
 * sustituida: el texto de cada bloque, las FAQ y los municipios cercanos vienen
 * de `localPages` y hablan de cosas distintas en cada una.
 *
 * Reutiliza la cabecera y el pie ligeros de las páginas de servicio (shead /
 * sfoot) en lugar del Nav de la home, cuyos enlaces son anclas que aquí no
 * existirían.
 */
import Base from './Base.astro';
import {
  NAV,
  BRAND,
  BUSINESS,
  LOCAL_PAGE,
  FOOTER,
  TARIFAS_INTRO,
  localPages,
  plans,
  services,
  type LocalPage,
} from '../data/copy.ts';
import { breadcrumbSchema, faqSchema, serviceSchema } from '../data/schema.ts';
import {
  LANG_NAME,
  LANG_SHORT,
  homePath,
  langOf,
  localPath,
  otherLangs,
  servicePath,
  startPath,
  t,
} from '../data/i18n.ts';

interface Props {
  page: LocalPage;
}

const { page } = Astro.props;
const lang = langOf(Astro.currentLocale);

// Estas landings existen sólo en castellano (son SEO local), así que no se pasa
// `alternates` a Base: sin alternativas no se declara ningún hreflang, y el
// selector de idioma del encabezado lleva a la portada del otro idioma.
const langLinks = otherLangs(lang);
const path = localPath(page.slug);
const heading = `${t(page.h1.line1, lang)} ${t(page.h1.line2, lang)}`;

const schema = [
  serviceSchema({
    name: heading,
    description: page.seo.description,
    path,
    area: page.area,
  }),
  breadcrumbSchema([
    { name: t(NAV.home, lang), path: homePath(lang) },
    { name: heading, path },
  ]),
  faqSchema(page.faqs),
];

// Las otras dos zonas, para enlazarlas desde el pie: enlazado lateral entre
// landings hermanas en vez de dejarlas colgando sólo de la home.
const siblings = localPages.filter((p) => p.slug !== page.slug);
---

<Base title={page.seo.title} description={page.seo.description} schema={schema}>
  <header class="shead">
    <a href={homePath(lang)} class="shead__brand" aria-label={`${BRAND} — ${t(NAV.home, lang)}`}>
      <img
        src="/logo-wordmark-compact.png"
        alt={BRAND}
        width="1180"
        height="240"
        class="shead__logo"
      />
    </a>
    <div class="shead__actions">
      {
        langLinks.map((l) => (
          <a
            href={l.href}
            class="shead__lang"
            hreflang={l.code}
            lang={l.code}
            aria-label={LANG_NAME[l.code]}
          >
            {LANG_SHORT[l.code]}
          </a>
        ))
      }
      <a href={homePath(lang)} class="shead__back">{t(LOCAL_PAGE.back, lang)}</a>
    </div>
  </header>

  <main class="loc">
    <nav class="loc__crumbs" aria-label="Migas de pan">
      <a href={homePath(lang)}>{BRAND}</a>
      <span aria-hidden="true">/</span>
      <span aria-current="page">{heading}</span>
    </nav>

    <section class="loc__hero">
      <h1 class="loc__h1">
        <span class="loc__line loc__line--solid">{t(page.h1.line1, lang)}</span>
        <span class="loc__line loc__line--outline">{t(page.h1.line2, lang)}</span>
      </h1>

      <div class="loc__rule"></div>

      <p class="loc__intro">{t(page.intro, lang)}</p>

      <a href={startPath(lang)} class="btn btn--blue loc__cta">{t(LOCAL_PAGE.cta, lang)}</a>
    </section>

    <section class="loc__blocks">
      {
        page.blocks.map((b) => (
          <article class="loc__block" data-reveal>
            <span class="loc__block-num">{b.num}</span>
            <div>
              <h2 class="loc__block-title">{t(b.title, lang)}</h2>
              <p class="loc__block-body">{t(b.body, lang)}</p>
            </div>
          </article>
        ))
      }
    </section>

    <section class="loc__section" data-reveal>
      <h2 class="loc__h2">{t(LOCAL_PAGE.servicesTitle, lang)}</h2>
      <div class="loc__services">
        {
          services.map((s) => (
            <a href={servicePath(s.slug, lang)} class="loc__service">{t(s.title, lang)}</a>
          ))
        }
      </div>
    </section>

    <section class="loc__section" data-reveal>
      <h2 class="loc__h2">{t(page.nearbyLabel, lang)}</h2>
      <ul class="loc__nearby">
        {page.nearby.map((n) => <li class="loc__chip">{n}</li>)}
      </ul>
    </section>

    <section class="loc__section" data-reveal>
      <h2 class="loc__h2">{t(LOCAL_PAGE.pricingTitle, lang)}</h2>
      <div class="loc__plans">
        {
          plans.map((p) => (
            <div class="loc__plan">
              <span class="loc__plan-name">{t(p.name, lang)}</span>
              <span class="loc__plan-price">
                {p.price} €<span class="loc__plan-mo">{t(TARIFAS_INTRO.perMonth, lang)}</span>
              </span>
              <span class="loc__plan-line">{t(p.line, lang)}</span>
            </div>
          ))
        }
      </div>
      <a href={`${homePath(lang)}#tarifas`} class="loc__link">{t(LOCAL_PAGE.pricingCta, lang)}</a>
    </section>

    <section class="loc__section" data-reveal>
      <h2 class="loc__h2">{t(LOCAL_PAGE.faqTitle, lang)}</h2>
      <div class="loc__faqs">
        {
          page.faqs.map((f) => (
            <div class="loc__faq">
              <h3 class="loc__faq-q">{t(f.q, lang)}</h3>
              <p class="loc__faq-a">{t(f.a, lang)}</p>
            </div>
          ))
        }
      </div>
    </section>

    <section class="loc__final" data-reveal>
      <p class="loc__final-note">{t(LOCAL_PAGE.ctaNote, lang)}</p>
      <a href={startPath(lang)} class="btn btn--blue">{t(LOCAL_PAGE.cta, lang)}</a>
    </section>
  </main>

  <footer class="sfoot">
    <div class="sfoot__links">
      {
        siblings.map((s) => (
          <a href={localPath(s.slug)} class="sfoot__link">
            {`${t(s.h1.line1, lang)} ${t(s.h1.line2, lang)}`}
          </a>
        ))
      }
      <a href={`${homePath(lang)}#tarifas`} class="sfoot__link">
        {t(LOCAL_PAGE.footerPricing, lang)}
      </a>
      <a href={startPath(lang)} class="sfoot__link">{t(LOCAL_PAGE.footerStart, lang)}</a>
      <a href={`tel:${BUSINESS.telephone}`} class="sfoot__link">{BUSINESS.telephoneDisplay}</a>
    </div>
    <span class="sfoot__copy">{t(FOOTER.location, lang)}</span>
  </footer>
</Base>

<style>
  /* --- cabecera (mismo patrón que las páginas de servicio) --- */
  .shead {
    position: sticky;
    top: 0;
    z-index: 100;
    display: flex;
    align-items: stretch;
    justify-content: space-between;
    background: var(--paper);
    border-bottom: var(--line-primary);
  }

  .shead__brand {
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 16px 26px;
    text-decoration: none;
    color: var(--ink);
    border-right: var(--line-primary);
  }

  .shead__logo {
    width: auto;
    height: 22px;
  }

  .shead__actions {
    display: flex;
    align-items: stretch;
  }

  .shead__lang,
  .shead__back {
    display: flex;
    align-items: center;
    padding: 0 22px;
    background: none;
    border: none;
    border-left: var(--line-primary);
    font-family: var(--font-mono);
    font-size: 13px;
    letter-spacing: 0.04em;
    color: var(--ink);
    text-decoration: none;
    cursor: pointer;
    transition: background 0.15s, color 0.15s;
  }

  .shead__lang:hover,
  .shead__back:hover,
  .shead__lang:focus-visible,
  .shead__back:focus-visible {
    background: var(--ink);
    color: #fff;
  }

  /* --- cuerpo --- */
  .loc {
    max-width: 1080px;
    margin: 0 auto;
    padding: 0 var(--gutter);
  }

  .loc__crumbs {
    display: flex;
    align-items: center;
    gap: 8px;
    padding: 26px 0 0;
    font-family: var(--font-mono);
    font-size: 12px;
    letter-spacing: 0.06em;
    color: var(--grey-muted);
    text-transform: uppercase;
  }

  .loc__crumbs a {
    color: var(--grey-muted);
    text-decoration: none;
  }

  .loc__crumbs a:hover,
  .loc__crumbs a:focus-visible {
    color: var(--blue);
  }

  .loc__hero {
    padding: 40px 0 56px;
    border-bottom: var(--line-primary);
  }

  .loc__h1 {
    margin: 0;
  }

  .loc__line {
    display: block;
    font-family: var(--font-display);
    font-weight: 900;
    font-size: clamp(46px, 8.4vw, 116px);
    letter-spacing: -0.045em;
    text-transform: uppercase;
  }

  .loc__line--solid {
    line-height: 0.84;
    color: var(--ink);
  }

  .loc__line--outline {
    line-height: 0.86;
    color: transparent;
    -webkit-text-stroke: 2px var(--ink);
  }

  @supports not (-webkit-text-stroke: 2px #000) {
    .loc__line--outline {
      color: var(--ink);
    }
  }

  .loc__rule {
    width: 220px;
    max-width: 100%;
    height: 12px;
    background: var(--blue);
    margin-top: 26px;
  }

  .loc__intro {
    font-family: var(--font-body);
    font-weight: 500;
    font-size: 21px;
    line-height: 1.45;
    max-width: 640px;
    margin-top: 28px;
  }

  .loc__cta {
    margin-top: 32px;
    background: var(--blue);
    color: #fff;
    border: var(--line-primary);
  }

  .loc__cta:hover,
  .loc__cta:focus-visible {
    background: var(--ink);
  }

  /* --- bloques de contenido --- */
  .loc__blocks {
    border-bottom: var(--line-primary);
  }

  .loc__block {
    display: grid;
    grid-template-columns: 80px 1fr;
    gap: 24px;
    padding: 34px 0;
    border-bottom: 1px solid var(--hairline);
  }

  .loc__block:last-child {
    border-bottom: none;
  }

  .loc__block-num {
    font-family: var(--font-mono);
    font-size: 14px;
    color: var(--grey-muted);
  }

  .loc__block-title {
    font-family: var(--font-display);
    font-weight: 800;
    font-size: clamp(22px, 2.6vw, 32px);
    letter-spacing: -0.02em;
    text-transform: uppercase;
  }

  .loc__block-body {
    font-family: var(--font-body);
    font-size: 17px;
    line-height: 1.55;
    color: var(--grey-body);
    max-width: 620px;
    margin-top: 12px;
  }

  /* --- secciones secundarias --- */
  .loc__section {
    padding: 44px 0;
    border-bottom: 1px solid var(--hairline);
  }

  .loc__h2 {
    font-family: var(--font-display);
    font-weight: 900;
    font-size: clamp(26px, 3.4vw, 42px);
    line-height: 1;
    letter-spacing: -0.03em;
    text-transform: uppercase;
    margin-bottom: 24px;
  }

  .loc__services {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
  }

  .loc__service {
    font-family: var(--font-mono);
    font-size: 13px;
    padding: 11px 16px;
    border: var(--line-primary);
    text-decoration: none;
    color: var(--ink);
    transition: background 0.15s, color 0.15s;
  }

  .loc__service:hover,
  .loc__service:focus-visible {
    background: var(--blue);
    color: #fff;
  }

  .loc__nearby {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    list-style: none;
  }

  .loc__chip {
    font-family: var(--font-mono);
    font-size: 13px;
    padding: 11px 16px;
    background: var(--surface-hover);
    border: 1px solid var(--hairline);
  }

  .loc__plans {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(190px, 1fr));
    gap: 0;
    border: var(--line-primary);
  }

  .loc__plan {
    display: flex;
    flex-direction: column;
    gap: 6px;
    padding: 22px 20px;
    border-right: 1px solid var(--hairline);
  }

  .loc__plan:last-child {
    border-right: none;
  }

  .loc__plan-name {
    font-family: var(--font-mono);
    font-size: 12px;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--grey-muted);
  }

  .loc__plan-price {
    font-family: var(--font-display);
    font-weight: 900;
    font-size: 34px;
    letter-spacing: -0.03em;
  }

  .loc__plan-mo {
    font-family: var(--font-mono);
    font-size: 13px;
    font-weight: 400;
    letter-spacing: 0;
    color: var(--grey-muted);
  }

  .loc__plan-line {
    font-family: var(--font-body);
    font-size: 14px;
    line-height: 1.4;
    color: var(--grey-body);
  }

  .loc__link {
    display: inline-block;
    margin-top: 20px;
    font-family: var(--font-mono);
    font-size: 13px;
    letter-spacing: 0.05em;
    color: var(--blue);
    text-decoration: none;
  }

  .loc__link:hover,
  .loc__link:focus-visible {
    text-decoration: underline;
  }

  .loc__faqs {
    display: grid;
    gap: 26px;
  }

  .loc__faq-q {
    font-family: var(--font-display);
    font-weight: 800;
    font-size: 19px;
    letter-spacing: -0.01em;
  }

  .loc__faq-a {
    font-family: var(--font-body);
    font-size: 16px;
    line-height: 1.55;
    color: var(--grey-body);
    max-width: 660px;
    margin-top: 8px;
  }

  .loc__final {
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 22px;
    padding: 48px 0 56px;
  }

  .loc__final-note {
    font-family: var(--font-body);
    font-size: 17px;
    line-height: 1.5;
    max-width: 420px;
  }

  .loc__final .btn {
    background: var(--blue);
    color: #fff;
    border: var(--line-primary);
  }

  .loc__final .btn:hover,
  .loc__final .btn:focus-visible {
    background: var(--ink);
  }

  /* --- pie --- */
  .sfoot {
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 18px;
    padding: 24px var(--gutter);
    border-top: var(--line-primary);
  }

  .sfoot__links {
    display: flex;
    flex-wrap: wrap;
    gap: 18px;
  }

  .sfoot__link {
    font-family: var(--font-mono);
    font-size: 13px;
    color: var(--ink);
    text-decoration: none;
  }

  .sfoot__link:hover,
  .sfoot__link:focus-visible {
    color: var(--blue);
  }

  .sfoot__copy {
    font-family: var(--font-mono);
    font-size: 12px;
    color: var(--grey-muted);
    text-transform: uppercase;
    letter-spacing: 0.04em;
  }

  /* --- responsive --- */
  @media (max-width: 600px) {
    .loc {
      padding: 0 20px;
    }
    .loc__line {
      font-size: clamp(38px, 11vw, 76px);
    }
    .loc__intro {
      font-size: 18px;
    }
    .loc__block {
      grid-template-columns: 1fr;
      gap: 8px;
    }
    .loc__cta,
    .loc__final .btn {
      width: 100%;
    }
    .sfoot {
      padding: 22px 20px;
    }
  }
</style>
